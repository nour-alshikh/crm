NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_STATUS_COOKIE=auth_status

# Deployed on a domain that shares no parent domain with the backend (e.g.
# *.vercel.app)? Set BACKEND_URL instead: /api and /sanctum are then proxied
# through Next.js and NEXT_PUBLIC_API_URL is ignored. See docs/deployment.md.
# BACKEND_URL=https://api.example.com
