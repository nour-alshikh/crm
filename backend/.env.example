APP_NAME=CRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Defaults target the Docker/Sail stack (compose.yaml) — see SETUP.md.
# Native (XAMPP/Herd) instead: DB_HOST=127.0.0.1, DB_USERNAME=root, DB_PASSWORD=
# and create the `crm` + `testing` databases yourself.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_COOKIE=app_session
AUTH_STATUS_COOKIE=auth_status

SANCTUM_STATEFUL_DOMAINS=localhost:3000
FRONTEND_URLS=http://localhost:3000

# Set when requests reach this app through a proxy (e.g. the Vercel frontend
# proxying /api here) so per-IP rate limiting sees real client IPs.
# Comma-separated IPs/CIDRs, or * to trust any proxy. See docs/deployment.md.
# TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker/Sail (compose.yaml) ---
# Host ports are shifted so the stack can run next to XAMPP (Apache :80, MySQL :3306).
APP_PORT=8000
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
# UID/GID the container's `sail` user runs as (Windows/Git Bash reports odd ids).
WWWUSER=1000
WWWGROUP=1000
