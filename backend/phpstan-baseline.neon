			count: 1
			path: app/TypeScript/AdminUserType.php

		-
			message: '#^Parameter \#1 \$user of static method App\\TypeScript\\PostAuthorType\:\:fromModel\(\) expects App\\Models\\User, Illuminate\\Database\\Eloquent\\Model\|null given\.$#'
			identifier: argument.type
			count: 1
			path: app/TypeScript/PostType.php

		-
			message: '#^Cannot call method toJSON\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/TypeScript/UserType.php

		-
			message: '#^Class Spatie\\MediaLibraryPro\\Models\\TemporaryUpload not found\.$#'
